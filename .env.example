# Demonstração local. Em produção, DATA_MODE=demo mostra a preparação.
APP_URL=http://localhost:3000
APP_ENV=local
APP_TIMEZONE=America/Sao_Paulo
DATA_MODE=demo

# Para dados reais, aplicar a migração e usar DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcionais: habilitam métricas agregadas no servidor da Vercel.
SUPABASE_SECRET_KEY=
RATE_LIMIT_HASH_SECRET=

# Consulta de preço por código MLB, acionada pelo administrador.
# Não há renovação OAuth automática nesta versão.
MERCADO_LIVRE_ENABLED=false
MERCADO_LIVRE_ACCESS_TOKEN=

# Envio explícito pelo painel; bot precisa poder publicar no canal.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
